# ─── HomePortal 环境配置 ───────────────────────────────────────────────────────
# 复制此文件为 .env 并填写实际值

# 监听端口（默认 3000）
PORT=3000

# 监听地址：生产建议 127.0.0.1，由 Nginx 对外；局域网调试可改为 0.0.0.0
# LISTEN_HOST=127.0.0.1

# 管理员密码（必填，≥8 位；未设置或为示例值时服务拒绝启动）
ADMIN_PASSWORD=

# JWT 签名密钥（必填，≥32 位随机串：openssl rand -hex 32；未设置或为示例值时服务拒绝启动）
JWT_SECRET=

# 门户标题：浏览器标签页名称与首页顶栏等（未设置时默认为「指引页」）
# PORTAL_TITLE=指引页
